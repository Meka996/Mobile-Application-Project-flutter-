rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUserData(data) {
      return data.keys().hasOnly(['name', 'email', 'phone', 'createdAt'])
        && data.keys().hasAll(['name', 'email', 'phone', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.email is string && data.phone is string
        && data.createdAt is timestamp;
    }

    function validCartFields(data) {
      return data.keys().hasOnly(['productId', 'size', 'color', 'quantity', 'updatedAt'])
        && data.keys().hasAll(['productId', 'size', 'color', 'quantity', 'updatedAt'])
        && data.productId is string && data.productId.size() > 0
        && data.size is string && data.size.size() > 0
        && data.color is string && data.color.size() > 0
        && data.quantity is int && data.quantity > 0
        && data.updatedAt is timestamp;
    }

    function validCartProduct(productId, quantity) {
      let productPath = /databases/$(database)/documents/products/$(productId);
      return exists(productPath)
        && get(productPath).data.isActive == true
        && get(productPath).data.price is number
        && get(productPath).data.price > 0
        && get(productPath).data.stock is int
        && get(productPath).data.stock >= quantity;
    }

    match /products/{productId} {
      allow read: if true;
      // Demo checkout can only decrease stock; other product fields stay protected.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
      allow create, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validUserData(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && validUserData(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']);
      allow delete: if false;

      match /favorites/{productId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['productId', 'addedAt'])
          && request.resource.data.keys().hasAll(['productId', 'addedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.addedAt is timestamp;
      }

      match /cart/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && validCartFields(request.resource.data)
          && validCartProduct(request.resource.data.productId, request.resource.data.quantity);
        allow update: if isOwner(userId)
          && validCartFields(request.resource.data)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt'])
                && request.resource.data.quantity < resource.data.quantity)
              || validCartProduct(request.resource.data.productId, request.resource.data.quantity));
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        // Demo orders are created by the signed-in user's Flutter transaction.
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['items', 'total', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['items', 'total', 'status', 'createdAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 20
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && request.resource.data.status == 'placed'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}